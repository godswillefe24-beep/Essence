# Required
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
JWT_SECRET=generate-a-random-32-byte-hex-string
ADMIN_PASSWORD=choose-a-strong-admin-password

# Optional — AI chat (Groq)
GROQ_API_KEY=gsk_your_key_here

# Optional — semantic search embeddings (Hugging Face)
HF_TOKEN=hf_your_token_here

# Optional — email notifications (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Optional — SendGrid alternative
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@essence-blog.com

# Optional — Mailchimp sync
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Server
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
# Comma-separated browser origins allowed for cross-origin API access.
# Leave empty to allow same-origin requests only.
CORS_ORIGINS=https://your-domain.example
